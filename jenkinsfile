    agent any

    tools {
        maven 'maven'
    }
    stages{
        stage('Git-Checkout'){
            steps{
                git url: 'https://github.com/diptomandal19-glitch/Devsecops-Ai.git', branch:'main'
            }
        }
        stage('Compile'){
            steps{
                sh '''
                    echo "Compiling the code..."
                    # Add your compilation commands here
                    mvn compile

                '''
            }
        }
        stage('Build'){
            steps{
                sh '''
                    echo "Building the application..."
                    # add your commands here
                    mvn pakage

                '''
            }
        }
    }
}